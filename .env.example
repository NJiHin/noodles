# Copy to .env and load with: uv run --env-file .env uvicorn noodles.api:from_env --factory --port 8000

# Needed for real runs (paid). Not needed when NOODLES_FAKE=1.
OPENAI_API_KEY=

# 1 = fake model clients, no OpenAI or Ollama calls.
NOODLES_FAKE=1

# Course store and run-log cache. Both are gitignored.
NOODLES_DATA=data
NOODLES_RUNS=runs
